# Python - Fichiers systèmes et cache
__pycache__/
*.py[cod]

# Environnement Virtuel (à la racine maintenant)
.venv/
venv/

# Variables d'environnement (Mots de passe)
.env

# Modèles IA (dans le backend)
# price_predictor.pkl est volontairement versionné (voir ORA-29) : le
# pipeline d'entraînement est déterministe, comme master_immo_final.csv
# qui est lui aussi commité. Seuls d'éventuels artefacts non retenus
# restent exclus.
backend/models/*.joblib

# Node / React (Frontend)
node_modules/
frontend/dist/
frontend/.env
.DS_Store

# Artefacts de tests E2E Playwright (ORA-59)
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
# Airflow logs
Airflow/logs/
airflow/logs/

Airflow/logs/

# Logs des scrapers (résumés persistés par run, voir ORA-13)
scripts/logs/

# Fichiers de sauvegarde locaux (ex : docker-compose.yml.backup, voir ORA-8)
*.backup

# Diagnostics du canari Playwright (screenshots/HTML dumps sur échec, propres
# à chaque run CI, uploadés en artefact — voir scripts/tests/e2e)
scripts/tests/e2e/diagnostics/
