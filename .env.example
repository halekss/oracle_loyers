# Copiez ce fichier en .env (racine) et/ou frontend/.env selon le service,
# puis renseignez vos propres valeurs. Ne jamais committer de vrais secrets.

# --- Backend Flask (backend/) ---

# Clé API Google AI Studio pour le chatbot Immotep (obligatoire pour /api/chat)
GEMINI_API_KEY=votre-cle-google-ai

# Modèle Gemini utilisé (optionnel, défaut : gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Nombre max de tokens générés par réponse du chatbot (optionnel, défaut : 800)
GEMINI_MAX_OUTPUT_TOKENS=800

# Température du modèle Gemini (optionnel, défaut : 0.7)
GEMINI_TEMPERATURE=0.7

# Origines autorisées en CORS, séparées par des virgules (optionnel).
# Si absent, seule une liste restrictive par défaut est autorisée
# (déploiement de démo + localhost:5173) : jamais de fallback ouvert sur '*'.
CORS_ORIGINS=https://oracle-loyers.onrender.com

# Port d'écoute du serveur Flask (optionnel, défaut : 5000 ; fourni par Render en prod)
PORT=5000

# Active le mode debug Flask si "1" (optionnel, à ne jamais activer en prod)
FLASK_DEBUG=0

# Limites de requêtes globales appliquées à toutes les routes (Flask-Limiter),
# plusieurs limites séparées par des virgules (optionnel, défaut ci-dessous).
# Un dépassement renvoie un 429 explicite.
RATE_LIMIT_DEFAULT=200 per day,50 per hour

# Limite dédiée à /api/chat, plus stricte que le défaut global : protège le
# quota gratuit Gemini contre un seul utilisateur/bot qui l'épuiserait pour
# tout le monde (optionnel, défaut ci-dessous).
RATE_LIMIT_CHAT=15 per hour

# --- Frontend Vite (frontend/) ---

# URL de base de l'API backend consommée par le frontend.
# Obligatoire en déploiement (Render). En local, si absent, le frontend
# utilise http://localhost:5000/api par défaut.
VITE_API_URL=http://localhost:5000/api

# --- Airflow (docker-compose.yml) ---
# Toutes obligatoires : docker-compose refuse de démarrer si l'une est
# absente (pas de valeur par défaut faible type "admin/admin" committée).

# Clé secrète du serveur web Airflow. Générez une vraie valeur, ex. :
#   openssl rand -hex 30
AIRFLOW__WEBSERVER__SECRET_KEY=generez-une-valeur-avec-openssl-rand--hex-30

# Identifiants du compte admin Airflow créé au premier démarrage
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changez-moi

# Email du compte admin (optionnel, défaut : admin@example.com)
AIRFLOW_ADMIN_EMAIL=admin@example.com
